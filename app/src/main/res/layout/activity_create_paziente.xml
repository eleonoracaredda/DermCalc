<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Titolo -->
        <TextView
            android:id="@+id/tvCreateTitle"
            style="@style/TextAppearance.DermCalc.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scheda_paziente"
            android:textSize="28sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- CARD DATI ANAGRAFICI -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAnagrafica"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/surfaceVariant"
            app:layout_constraintWidth_max="488dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvCreateTitle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/TextAppearance.DermCalc.Subheadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dati_anagrafici"
                    android:textColor="@color/primaryColor"
                    android:textAllCaps="true"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Nome -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNome"
                    style="@style/Widget.DermCalc.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/nome"
                    app:startIconDrawable="@drawable/ic_person">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Cognome -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCognome"
                    style="@style/Widget.DermCalc.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/cognome"
                    app:startIconDrawable="@drawable/ic_person">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCognome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Codice Fiscale -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCodiceFiscale"
                    style="@style/Widget.DermCalc.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/codice_fiscale"
                    app:startIconDrawable="@drawable/ic_edit">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCodiceFiscale"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAllCaps="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Data di nascita -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDataNascita"
                    style="@style/Widget.DermCalc.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/data_nascita_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDataNascita"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="date" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Sesso -->
                <TextView
                    android:id="@+id/tvSessoLabel"
                    style="@style/TextAppearance.DermCalc.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sesso_label"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <RadioGroup
                    android:id="@+id/rgSesso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <RadioButton
                        android:id="@+id/rbMaschio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/maschio" />

                    <RadioButton
                        android:id="@+id/rbFemmina"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32dp"
                        android:text="@string/femmina" />
                </RadioGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CARD INFORMAZIONI CLINICHE -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardClinica"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/surfaceVariant"
            app:layout_constraintWidth_max="488dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardAnagrafica">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/TextAppearance.DermCalc.Subheadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/informazioni_cliniche"
                    android:textColor="@color/primaryColor"
                    android:textAllCaps="true"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Terapia -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilTerapia"
                    style="@style/Widget.DermCalc.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/terapia_attuale">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTerapia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Comorbilità -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilComorbilita"
                    style="@style/Widget.DermCalc.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/comorbilita">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etComorbilita"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Data inizio terapia -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDataInizioTerapia"
                    style="@style/Widget.DermCalc.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/data_inizio_terapia_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDataInizioTerapia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="date" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CARD CAREGIVER -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCaregiver"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/surfaceVariant"
            app:layout_constraintWidth_max="488dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardClinica">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/TextAppearance.DermCalc.Subheadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/caregiver_emergenza"
                    android:textColor="@color/primaryColor"
                    android:textAllCaps="true"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Nome caregiver -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCaregiverNome"
                    style="@style/Widget.DermCalc.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/nome_caregiver"
                    app:startIconDrawable="@drawable/ic_person">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCaregiverNome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Telefono caregiver -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCaregiverTelefono"
                    style="@style/Widget.DermCalc.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/telefono_caregiver">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCaregiverTelefono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Consenso -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swConsenso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/consenso_trattamento"
            android:textColor="@color/textPrimary"
            android:textSize="14sp"
            app:layout_constraintWidth_max="488dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardCaregiver" />

        <!-- Bottone Salva -->
        <Button
            android:id="@+id/btnSalvaPaziente"
            style="@style/Widget.DermCalc.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp"
            android:text="@string/salva_paziente"
            app:layout_constraintWidth_max="320dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/swConsenso"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
