<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Header colorato -->
            <View
                android:id="@+id/headerView"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:background="@color/primaryColor"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTitle"
                style="@style/TextAppearance.DermCalc.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:text="@string/calcolatore_easi"
                android:textColor="@color/white"
                android:textSize="24sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Card Selezione Distretto -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBodyPart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="-40dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/surfaceVariant"
                app:layout_constraintWidth_max="488dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/headerView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvSelectDistrictLabel"
                        style="@style/TextAppearance.DermCalc.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/seleziona_distretto"
                        android:textStyle="bold"
                        android:textColor="@color/primaryColor"
                        android:labelFor="@id/chipGroupBodyPart" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupBodyPart"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipHead"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/distretto_testa_collo" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTrunk"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/distretto_tronco" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipArms"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/distretto_arti_superiori" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipLegs"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/distretto_arti_inferiori" />

                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card Gravità -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGravity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/surfaceVariant"
                app:layout_constraintWidth_max="488dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardBodyPart">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.DermCalc.Subheadline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gravit_dei_segni_clinici"
                        android:textSize="16sp" />

                    <!-- Eritema -->
                    <TextView
                        android:id="@+id/tvEritemaLabel"
                        style="@style/TextAppearance.DermCalc.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/eritema"
                        android:labelFor="@id/sbEritema" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <SeekBar
                            android:id="@+id/sbEritema"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="3" />
                        <TextView
                            android:id="@+id/tvEritemaValue"
                            style="@style/TextAppearance.DermCalc.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="80dp"
                            android:gravity="end"
                            android:accessibilityLiveRegion="polite"
                            android:text="@string/desc_zero" />
                    </LinearLayout>

                    <!-- Edema -->
                    <TextView
                        android:id="@+id/tvEdemaLabel"
                        style="@style/TextAppearance.DermCalc.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/edema"
                        android:labelFor="@id/sbEdema" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <SeekBar
                            android:id="@+id/sbEdema"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="3" />
                        <TextView
                            android:id="@+id/tvEdemaValue"
                            style="@style/TextAppearance.DermCalc.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="80dp"
                            android:gravity="end"
                            android:accessibilityLiveRegion="polite"
                            android:text="@string/desc_zero" />
                    </LinearLayout>

                    <!-- Escoriazioni -->
                    <TextView
                        android:id="@+id/tvEscoriazioniLabel"
                        style="@style/TextAppearance.DermCalc.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/escoriazioni"
                        android:labelFor="@id/sbEscoriazioni" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <SeekBar
                            android:id="@+id/sbEscoriazioni"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="3" />
                        <TextView
                            android:id="@+id/tvEscoriazioniValue"
                            style="@style/TextAppearance.DermCalc.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="80dp"
                            android:gravity="end"
                            android:accessibilityLiveRegion="polite"
                            android:text="@string/desc_zero" />
                    </LinearLayout>

                    <!-- Lichenificazione -->
                    <TextView
                        android:id="@+id/tvLichenificazioneLabel"
                        style="@style/TextAppearance.DermCalc.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/lichenificazione"
                        android:labelFor="@id/sbLichenificazione" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <SeekBar
                            android:id="@+id/sbLichenificazione"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="3" />
                        <TextView
                            android:id="@+id/tvLichenificazioneValue"
                            style="@style/TextAppearance.DermCalc.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="80dp"
                            android:gravity="end"
                            android:accessibilityLiveRegion="polite"
                            android:text="@string/desc_zero" />
                    </LinearLayout>

                    <!-- Area -->
                    <TextView
                        android:id="@+id/tvAreaLabel"
                        style="@style/TextAppearance.DermCalc.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/area"
                        android:textColor="@color/primaryDarkColor"
                        android:textStyle="bold"
                        android:labelFor="@id/sbArea" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <SeekBar
                            android:id="@+id/sbArea"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="6" />
                        <TextView
                            android:id="@+id/tvAreaValue"
                            style="@style/TextAppearance.DermCalc.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="80dp"
                            android:gravity="end"
                            android:accessibilityLiveRegion="polite"
                            android:text="@string/area_0" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Note -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNotes"
                style="@style/Widget.DermCalc.EditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="12dp"
                app:layout_constraintWidth_max="488dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardGravity">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:hint="@string/note_hint"
                    android:inputType="textMultiLine"
                    android:minHeight="60dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Bottone Calcola -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalculateEasi"
                style="@style/Widget.DermCalc.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="16dp"
                android:text="@string/calcola_e_salva"
                app:layout_constraintWidth_max="320dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilNotes" />

            <!-- Risultato Progressivo -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEasiResult"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/surfaceVariant"
                app:layout_constraintWidth_max="488dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnCalculateEasi">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/avanzamento_valutazione"
                        android:textColor="@color/textSecondary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressEvaluation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:trackThickness="8dp"
                        app:trackCornerRadius="4dp"
                        android:max="4"
                        android:progress="1"
                        app:indicatorColor="@color/secondaryColor" />

                    <TextView
                        android:id="@+id/tvProgressDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/regioni_completate_default"
                        android:textSize="12sp"
                        android:textColor="@color/textSecondary" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/totale_easi"
                                android:textSize="12sp"
                                android:textColor="@color/primaryColor"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvTotalScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/default_score"
                                android:textSize="32sp"
                                android:textStyle="bold"
                                android:textColor="@color/textPrimary" />

                            <TextView
                                android:id="@+id/tvSeverityLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="2dp"
                                android:background="@drawable/bg_severity_badge"
                                android:text="@string/severita"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                tools:visibility="visible"
                                tools:backgroundTint="@color/gravity_2"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvCurrentRegionScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/ic_launcher_background"
                            android:backgroundTint="@color/backgroundColor"
                            android:padding="8dp"
                            android:text="@string/regione_score_default"
                            android:textSize="13sp"
                            android:textColor="@color/textSecondary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="40dp"
                android:text="@string/indietro"
                app:layout_constraintTop_toBottomOf="@id/cardEasiResult"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>