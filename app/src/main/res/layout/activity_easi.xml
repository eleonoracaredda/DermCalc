<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Titolo -->
        <TextView
            android:id="@+id/tvTitle"
            style="@style/TextAppearance.DermCalc.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/calcolatore_easi"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Seleziona distretto -->
        <TextView
            android:id="@+id/tvBodyPartLabel"
            style="@style/TextAppearance.DermCalc.Subheadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/seleziona_distretto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <Spinner
            android:id="@+id/spinnerBodyPart"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/btn_dropdown"
            android:entries="@array/body_parts_easi"
            android:padding="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvBodyPartLabel" />

        <!-- Gravità -->
        <TextView
            android:id="@+id/tvGravityLabel"
            style="@style/TextAppearance.DermCalc.Subheadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/gravit_dei_segni_clinici"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spinnerBodyPart" />

        <!-- Eritema -->
        <TextView
            android:id="@+id/tvEritemaLabel"
            style="@style/TextAppearance.DermCalc.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/eritema"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvGravityLabel" />

        <SeekBar
            android:id="@+id/sbEritema"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="3"
            android:progress="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvEritemaValue"
            app:layout_constraintTop_toBottomOf="@id/tvEritemaLabel" />

        <TextView
            android:id="@+id/tvEritemaValue"
            style="@style/TextAppearance.DermCalc.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"
            android:gravity="end"
            android:text="@string/desc_zero"
            app:layout_constraintTop_toTopOf="@id/sbEritema"
            app:layout_constraintBottom_toBottomOf="@id/sbEritema"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Edema -->
        <TextView
            android:id="@+id/tvEdemaLabel"
            style="@style/TextAppearance.DermCalc.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/edema"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sbEritema" />

        <SeekBar
            android:id="@+id/sbEdema"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="3"
            android:progress="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvEdemaValue"
            app:layout_constraintTop_toBottomOf="@id/tvEdemaLabel" />

        <TextView
            android:id="@+id/tvEdemaValue"
            style="@style/TextAppearance.DermCalc.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"
            android:gravity="end"
            android:text="@string/desc_zero"
            app:layout_constraintTop_toTopOf="@id/sbEdema"
            app:layout_constraintBottom_toBottomOf="@id/sbEdema"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Escoriazioni -->
        <TextView
            android:id="@+id/tvEscoriazioniLabel"
            style="@style/TextAppearance.DermCalc.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/escoriazioni"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sbEdema" />

        <SeekBar
            android:id="@+id/sbEscoriazioni"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="3"
            android:progress="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvEscoriazioniValue"
            app:layout_constraintTop_toBottomOf="@id/tvEscoriazioniLabel" />

        <TextView
            android:id="@+id/tvEscoriazioniValue"
            style="@style/TextAppearance.DermCalc.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"
            android:gravity="end"
            android:text="@string/desc_zero"
            app:layout_constraintTop_toTopOf="@id/sbEscoriazioni"
            app:layout_constraintBottom_toBottomOf="@id/sbEscoriazioni"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Lichenificazione -->
        <TextView
            android:id="@+id/tvLichenificazioneLabel"
            style="@style/TextAppearance.DermCalc.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/lichenificazione"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sbEscoriazioni" />

        <SeekBar
            android:id="@+id/sbLichenificazione"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="3"
            android:progress="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvLichenificazioneValue"
            app:layout_constraintTop_toBottomOf="@id/tvLichenificazioneLabel" />

        <TextView
            android:id="@+id/tvLichenificazioneValue"
            style="@style/TextAppearance.DermCalc.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"
            android:gravity="end"
            android:text="@string/desc_zero"
            app:layout_constraintTop_toTopOf="@id/sbLichenificazione"
            app:layout_constraintBottom_toBottomOf="@id/sbLichenificazione"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Area -->
        <TextView
            android:id="@+id/tvAreaLabel"
            style="@style/TextAppearance.DermCalc.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/area"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sbLichenificazione" />

        <SeekBar
            android:id="@+id/sbArea"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="6"
            android:progress="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvAreaValue"
            app:layout_constraintTop_toBottomOf="@id/tvAreaLabel" />

        <TextView
            android:id="@+id/tvAreaValue"
            style="@style/TextAppearance.DermCalc.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"
            android:gravity="end"
            android:text="@string/area_0"
            app:layout_constraintTop_toTopOf="@id/sbArea"
            app:layout_constraintBottom_toBottomOf="@id/sbArea"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Note -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNotes"
            style="@style/Widget.DermCalc.EditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sbArea">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="@string/note_hint"
                android:inputType="textMultiLine"
                android:minHeight="80dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Bottone -->
        <Button
            android:id="@+id/btnCalculateEasi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/calcola_e_salva"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilNotes" />

        <!-- Risultato -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEasiResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/primaryLightColor"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/btnCalculateEasi"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvResult"
                    style="@style/TextAppearance.DermCalc.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/risultato_label"
                    android:textAlignment="center"
                    android:textSize="20sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
