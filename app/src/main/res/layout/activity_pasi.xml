<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/calcolatore_pasi"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#333333"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvBodyPartLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/seleziona_distretto"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#555555"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />
        <Spinner
            android:id="@+id/spinnerBodyPart"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/btn_dropdown"
            android:entries="@array/body_parts_pasi"
            android:padding="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvBodyPartLabel" />
        <TextView
            android:id="@+id/tvGravityLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/gravit_dei_segni_clinici"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spinnerBodyPart" />

        <!-- Eritema -->
        <TextView
            android:id="@+id/tvEritemaLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/eritema"
            android:textColor="#666666"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvGravityLabel" />
        <SeekBar
            android:id="@+id/sbEritema"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="4"
            android:progress="0"
            app:layout_constraintEnd_toStartOf="@+id/tvEritemaValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvEritemaLabel" />
        <TextView
            android:id="@+id/tvEritemaValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"
            android:gravity="end"
            android:text="@string/desc_zero"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#5B4DFF"
            app:layout_constraintBottom_toBottomOf="@id/sbEritema"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/sbEritema" />

        <!-- Indurimento -->
        <TextView
            android:id="@+id/tvIndurimentoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/indurimento_spessore_infiltrazione"
            android:textColor="#666666"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sbEritema" />
        <SeekBar
            android:id="@+id/sbIndurimento"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="4"
            android:progress="0"
            app:layout_constraintEnd_toStartOf="@+id/tvIndurimentoValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvIndurimentoLabel" />
        <TextView
            android:id="@+id/tvIndurimentoValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"
            android:gravity="end"
            android:text="@string/desc_zero"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#5B4DFF"
            app:layout_constraintBottom_toBottomOf="@id/sbIndurimento"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/sbIndurimento" />

        <!-- Desquamazione -->
        <TextView
            android:id="@+id/tvDesquamazioneLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/Desquamazione"
            android:textColor="#666666"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sbIndurimento" />
        <SeekBar
            android:id="@+id/sbDesquamazione"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="4"
            android:progress="0"
            app:layout_constraintEnd_toStartOf="@+id/tvDesquamazioneValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDesquamazioneLabel" />
        <TextView
            android:id="@+id/tvDesquamazioneValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"
            android:gravity="end"
            android:text="@string/desc_zero"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#5B4DFF"
            app:layout_constraintBottom_toBottomOf="@id/sbDesquamazione"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/sbDesquamazione" />

        <!-- Area -->
        <TextView
            android:id="@+id/tvAreaLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/area"
            android:textColor="#666666"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sbDesquamazione" />
        <SeekBar
            android:id="@+id/sbArea"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="6"
            android:progress="0"
            app:layout_constraintEnd_toStartOf="@+id/tvAreaValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAreaLabel" />
        <TextView
            android:id="@+id/tvAreaValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"
            android:gravity="end"
            android:text="@string/area_0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#5B4DFF"
            app:layout_constraintBottom_toBottomOf="@id/sbArea"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/sbArea" />

        <EditText
            android:id="@+id/etNotes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/note_hint"
            android:inputType="textMultiLine"
            android:minHeight="48dp"
            android:gravity="top"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sbArea" />

        <Button
            android:id="@+id/btnCalculatePasi"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#5B4DFF"
            android:text="@string/calcola_e_salva"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etNotes"
            tools:ignore="VisualLintButtonSize" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:text="@string/risultato_pasi_label"
            android:textColor="#333333"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAlignment="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.498"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnCalculatePasi"
            app:layout_constraintVertical_bias="0.26" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
